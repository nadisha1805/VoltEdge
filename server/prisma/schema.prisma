// Prisma schema for VOLTEDGE Electronics
// Milestone 2: Admin Dashboard & Showroom Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. ADMIN USERS & RBAC
// -------------------------------------------------------------

model AdminUser {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  fullName           String
  phone              String?
  role               String             @default("SALES_STAFF") // "SUPER_ADMIN", "ADMIN", "INVENTORY_MANAGER", "SALES_STAFF"
  avatar             String?
  isActive           Boolean            @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  activityLogs       ActivityLog[]
  inventoryMovements InventoryMovement[]
  orderStatusLogs    OrderStatusHistory[]
}

model ActivityLog {
  id          String     @id @default(uuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminName   String?
  action      String     // "CREATE", "UPDATE", "DELETE", "LOGIN", "ADJUST_STOCK", "STATUS_CHANGE"
  module      String     // "PRODUCTS", "CATEGORIES", "BRANDS", "INVENTORY", "ORDERS", "COUPONS", "STAFF", "ENQUIRIES", "AUTH", "SETTINGS"
  description String
  ipAddress   String?
  userAgent   String?
  metadata    String?    // JSON string for details
  createdAt   DateTime   @default(now())
}

// -------------------------------------------------------------
// 2. CATEGORIES & BRANDS
// -------------------------------------------------------------

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  slug         String     @unique
  description  String?
  icon         String?
  imageUrl     String?
  featured     Boolean    @default(false)
  displayOrder Int        @default(0)
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  isArchived   Boolean    @default(false)
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  featured    Boolean   @default(false)
  isArchived  Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// -------------------------------------------------------------
// 3. PRODUCTS & INVENTORY
// -------------------------------------------------------------

model Product {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  sku                String              @unique
  brandId            String
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description        String
  shortDescription   String?
  sellingPrice       Float
  costPrice          Float               @default(0.0) // Used for inventory valuation: Valuation = Sum(costPrice * stockQuantity)
  originalPrice      Float?
  discountPercentage Float?
  rating             Float               @default(0.0)
  reviewCount        Int                 @default(0)
  stockStatus        String              @default("IN_STOCK") // "IN_STOCK", "LOW_STOCK", "OUT_OF_STOCK"
  stockQuantity      Int                 @default(15)
  warrantyInfo       String?             @default("1 Year Brand Warranty")
  images             String              // JSON stringified array of image URLs
  primaryImage       String
  tags               String?             // Comma-separated tags
  specifications     String?             // JSON stringified key-value specs
  isFeatured         Boolean             @default(false)
  isBestSeller       Boolean             @default(false)
  isLatestArrival    Boolean             @default(false)
  isSpecialOffer     Boolean             @default(false)
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
}

model InventoryMovement {
  id               String     @id @default(uuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  previousQuantity Int
  quantityChanged  Int
  newQuantity      Int
  movementType     String     // "STOCK_IN", "STOCK_OUT", "ADJUSTMENT", "RETURN_RESTOCK", "CORRECTION"
  reason           String
  referenceNumber  String?    // e.g., "PO-9021", "ADJ-2026-01"
  adminUserId      String?
  adminUser        AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  updatedBy        String     // Persistent name/email for audit log
  createdAt        DateTime   @default(now())
}

// -------------------------------------------------------------
// 4. CUSTOMERS & ADDRESSES
// -------------------------------------------------------------

model Customer {
  id          String            @id @default(uuid())
  firstName   String
  lastName    String
  email       String            @unique
  phone       String?
  avatar      String?
  status      String            @default("ACTIVE") // "ACTIVE", "INACTIVE", "BLOCKED"
  totalOrders Int               @default(0)
  totalSpent  Float             @default(0.0)
  notes       String?
  isArchived  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  addresses   CustomerAddress[]
  orders      Order[]
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressType  String   @default("SHIPPING") // "SHIPPING", "BILLING"
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -------------------------------------------------------------
// 5. ORDERS & STATUS HISTORY
// -------------------------------------------------------------

model Order {
  id               String               @id @default(uuid())
  orderNumber      String               @unique // e.g. "VOLT-2026-1001"
  customerId       String?
  customer         Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerEmail    String
  customerPhone    String?
  shippingAddress  String               // Formatted / JSON address
  billingAddress   String?              // Formatted / JSON address
  subtotal         Float
  discountAmount   Float                @default(0.0)
  taxAmount        Float                @default(0.0)
  shippingFee      Float                @default(0.0)
  totalAmount      Float
  paymentStatus    String               @default("PENDING") // "PENDING", "PAID", "FAILED", "REFUNDED", "PARTIALLY_REFUNDED"
  paymentMethod    String               @default("CASH_ON_DELIVERY") // "CREDIT_CARD", "UPI", "NET_BANKING", "CASH_ON_DELIVERY"
  paymentReference String?
  orderStatus      String               @default("PENDING") // "PENDING", "CONFIRMED", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"
  notes            String?
  couponCode       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  productSku      String
  productImageUrl String?
  unitPrice       Float
  quantity        Int
  totalPrice      Float
  createdAt       DateTime @default(now())
}

model OrderStatusHistory {
  id          String     @id @default(uuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  comment     String?
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  updatedBy   String     // Staff name or "System"
  createdAt   DateTime   @default(now())
}

// -------------------------------------------------------------
// 6. COUPONS & PROMOTIONS
// -------------------------------------------------------------

model Coupon {
  id                String        @id @default(uuid())
  code              String        @unique
  description       String
  discountType      String        @default("PERCENTAGE") // "PERCENTAGE", "FIXED"
  discountValue     Float
  minOrderAmount    Float         @default(0.0)
  maxDiscount       Float?
  usageLimit        Int?
  perCustomerLimit  Int           @default(1)
  usageCount        Int           @default(0)
  startDate         DateTime      @default(now())
  expiryDate        DateTime?
  isActive          Boolean       @default(true)
  isArchived        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  usages            CouponUsage[]
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId         String?
  customerEmail   String?
  discountApplied Float
  usedAt          DateTime @default(now())
}

// -------------------------------------------------------------
// 7. CONTACT ENQUIRIES & NEWSLETTER
// -------------------------------------------------------------

model ContactEnquiry {
  id          String    @id @default(uuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  status      String    @default("NEW") // "NEW", "IN_PROGRESS", "RESOLVED", "ARCHIVED"
  adminNotes  String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model NewsletterSubscription {
  id           String   @id @default(uuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

// -------------------------------------------------------------
// 8. STOREFRONT BANNERS, TESTIMONIALS & SHOWROOM SETTINGS
// -------------------------------------------------------------

model Banner {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  badge        String?
  ctaText      String   @default("Shop Now")
  ctaLink      String   @default("/shop")
  imageUrl     String
  bgGradient   String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id               String   @id @default(uuid())
  name             String
  role             String?
  avatar           String?
  rating           Int      @default(5)
  comment          String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model ShowroomSettings {
  id                String   @id @default("default")
  storeName         String   @default("VOLTEDGE Electronics")
  tagline           String   @default("Powering Your Digital World.")
  email             String   @default("support@voltedge-electronics.com")
  phone             String   @default("+91 98765 43210")
  address           String   @default("Plot 42, Digital Corridor, Cyber City, Bangalore - 560100")
  businessHours     String   @default("Mon - Sat: 9:30 AM - 9:00 PM | Sun: 10:00 AM - 7:00 PM")
  currency          String   @default("INR")
  currencySymbol    String   @default("₹")
  lowStockThreshold Int      @default(5)
  taxRate           Float    @default(18.0)
  updatedAt         DateTime @updatedAt
}
