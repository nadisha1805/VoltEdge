# Server Configuration
PORT=5000
DATABASE_URL="file:./dev.db"
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Customer JWT Secret & Cookie Key
CUSTOMER_JWT_SECRET=your_customer_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here

# Razorpay Payment Gateway (Test Mode / Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cash on Delivery Configuration (true/false)
COD_ENABLED=true

# Notification / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="VOLTEDGE Electronics <no-reply@voltedge-electronics.com>"
