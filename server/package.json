    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^6.9.16",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
